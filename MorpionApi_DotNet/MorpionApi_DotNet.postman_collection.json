                "moves"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Recuperer la partie en cours",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/morpion/games/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "morpion",
                "games",
                "current"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Controle securite",
      "item": [
